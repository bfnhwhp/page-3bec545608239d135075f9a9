k)}\n.faq-list summary::-webkit-details-marker{display:none}\n.faq-list summary::after{content:\"+\";font-size:22px;color:var(--purple);font-weight:400;transition:transform .2s ease}\n.faq-list details[open] summary::after{content:\"–\"}\n.faq-list details p{margin:14px 0 0;color:var(--ink-soft);font-size:15px;max-width:780px}\n.faq-list details p + p{margin-top:10px}\n\n/* —— 客户端区块 —— */\n.client-row{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--rule);background:var(--paper)}\n.client-row > div{padding:28px;border-right:1px solid var(--rule);position:relative}\n.client-row > div:last-child{border-right:0}\n.client-row .os{font-size:12px;letter-spacing:.2em;color:var(--ink-mute);text-transform:uppercase;font-weight:600}\n.client-row h4{margin:8px 0 6px;font-size:18px}\n.client-row p{margin:0;color:var(--ink-soft);font-size:14px}\n\n/* —— 底部固定式文字导航 —— */\n.bottomnav{position:fixed;left:0;right:0;bottom:0;background:rgba(243,241,246,.92);border-top:1px solid var(--rule);z-index:50;backdrop-filter:blur(8px)}\n.bottomnav .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:14px;padding-bottom:14px;font-size:13px;letter-spacing:.18em;text-transform:uppercase}\n.bottomnav a{color:var(--ink-soft);border-bottom:none}\n.bottomnav a:hover{color:var(--purple)}\n.bottomnav .brand{font-weight:800;color:var(--ink);letter-spacing:.04em;text-transform:none;font-size:14px}\n.bottomnav .brand .dot{display:inline-block;width:8px;height:8px;background:var(--purple);margin-right:8px;vertical-align:middle}\n\n/* —— footer —— */\nfooter{padding:80px 0 120px;color:var(--ink-mute);font-size:13px}\nfooter .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;border-top:1px solid var(--rule);padding-top:32px}\n\n/* —— responsive —— */\n@media (max-width: 900px){.hero-grid > div{grid-column:span 12}\n  .col-2{grid-template-columns:1fr;gap:36px}\n  .col-3{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;gap:24px;padding:32px 24px 32px 32px}\n  .plan ul{grid-template-columns:1fr}\n  .plan .note{border-left:0;border-top:1px solid var(--rule);padding-left:0;padding-top:14px}\n  .plan .tag{position:static;display:inline-block;margin-bottom:8px}\n  .client-row{grid-template-columns:repeat(2,1fr)}\n  .client-row > div{border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}\n  .client-row > div:nth-child(2n){border-right:0}\n  .client-row > div:nth-last-child(-n+2){border-bottom:0}\n  .brand-poster{font-size:clamp(96px,28vw,200px)}\n  section.block{padding:64px 0}\n  .bottomnav .wrap{font-size:11px;gap:10px;flex-wrap:wrap}\n  .bottomnav .wrap a:nth-child(n+4){display:none}}\n</style><header class=\"hero\" id=\"top\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"mark\"><span class=\"dot\"></span>Bear · Network Companion</div>\n      <div class=\"meta\">VOL.01 / ISSUE NO.8193 / LAT 35.2°N</div>\n    </div>\n\n    <h1 class=\"brand-poster\">\n      Bear\n      <span>—</span>\n      熊\n    </h1>\n    <p class=\"small\">在浅灰色的夜幕下，一只不慌不忙的熊醒来。它的皮毛沾着电光紫的雨滴，沿着光纤、基站、地下电缆，替每一个夜里还没睡的人，把远方的页面带回屏幕。Bear 不是一个口号，它是一段陪伴，一种被翻译过的距离。</p>\n\n    <div class=\"hero-grid\">\n      <div><b>代号</b>B-8193 · 记录编号</div>\n      <div><b>语调</b>专栏作者式 · 不催促，不喧哗</div>\n      <div><b>色谱</b>浅灰 #f3f1f6 / 电光紫 #5b2bd9</div>\n      <div><b>姿态</b>海报式 · 单色铺陈</div>\n      <div><b>导航</b>底部固定 · 文字优先</div>\n      <div><b>结构</b>卡片色条 · 单列套餐</div>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<section class=\"block\" id=\"field-notes\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">Field Notes · 田野手记</div>\n    <h2>在喧嚣的网络里，<em>留一段</em>可以慢慢走的路。</h2>\n    <p class=\"lede\">这一组文字不是说明书，更像是一个专栏作者在凌晨三点写下的观察。Bear 选择了安静，是因为它相信：真正能陪你很久的工具，从来不大声。</p>\n\n    <div class=\"col-2 diary\">\n      <article>\n        <div class=\"stamp\"><span>手记 · 01</span><span>凌晨 02:14</span></div>\n        <h3>关于「不打扰」的承诺</h3>\n        <p>很多人问 Bear 究竟快不快、稳定不稳定。但真正让我们停下来想一想的是另一件事：它能不能在你不需要的时候沉默？一只熊在森林里走路从不打招呼，它只在出现时才被看见。我们把这份克制也写进了产品里——没有浮窗弹窗，没有冗余提醒，没有永不停歇的「续费倒计时」。</p>\n      </article>\n      <article>\n        <div class=\"stamp\"><span>手记 · 02</span><span>凌晨 02:38</span></div>\n        <h3>电光紫不是噱头</h3>\n        <p>配色只是表象。电光紫在我们的语境里，意味着在大量冷色调信号中，那一抹被识别出来的清晰。Bear 的客户端、节点命名、订阅信息、状态页，都遵循同一套色标，让你扫一眼就能判断：这条线路还在呼吸。</p>\n      </article>\n      <article>\n        <div class=\"stamp\"><span>手记 · 03</span><span>凌晨 03:02</span></div>\n        <h3>关于订阅的另一面</h3>\n        <p>一份订阅其实是两个人之间的契约。你付出一笔钱和一点耐心，我们交出一条稳定的线路和一份能被读懂的工单回复。我们不擅长华丽的形容词，所以把承诺写在套餐里、写进 FAQ 里——白纸黑字，留作凭证。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section class=\"block alt\" id=\"cards\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">Things Bear Carries · 熊会随身带的东西</div>\n    <h2>四件小物，构成<em>一只</em>完整的 Bear。</h2>\n    <p class=\"lede\">它们不是功能列表，而是行为方式的注脚。下面这四张卡片，每一张的左侧都有一条电光紫色的标记——你扫过去就能判断，这是不是 Bear 在说话。</p>\n\n    <div class=\"col-3\">\n      <div class=\"strip-card\">\n        <div class=\"kicker\">01 · SILENCE</div>\n        <h3>静默的客户端</h3>\n        <p>启动后不再打扰你。它只在你需要切换节点、查看用量、续费时出现。</p>\n      </div>\n      <div class=\"strip-card alt\">\n        <div class=\"kicker\">02 · ROUTES</div>\n        <h3>可读的节点名</h3>\n        <p>节点名写得像地名而不是字符串。你看到的是「森林小径 03」「雨水回廊」，而不是一串无意义的字符。</p>\n      </div>\n      <div class=\"strip-card\">\n        <div class=\"kicker\">03 · LEDGER</div>\n        <h3>透明的账本</h3>\n        <p>每月用量、到期日、历史续费记录，都在一页之内。不藏按钮，不藏条款。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"block\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">Subscriptions · 订阅方案</div>\n    <h2>三档<em>单列</em>套餐，按你需要的速度走。</h2>\n    <p class=\"lede\">套餐按从上到下的顺序排列，最上方是最轻的陪伴，最下方是更厚重的同行。每一张卡片的左侧都有一条色条，紫色代表编辑推荐，灰色代表普通版本。</p>\n\n    <div class=\"plans\">\n\n      <article class=\"plan\">\n        <span class=\"tag muted\">ENTRY</span>\n        <div class=\"head\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15<small>/月</small></div>\n          <div class=\"annual\">按年付仅需 ¥150/年</div>\n        </div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"note\">适合刚开始接触代理的轻量使用者。流量足够覆盖日常浏览、邮件和偶尔的远程办公需求。</p>\n      </article>\n\n      <article class=\"plan featured\">\n        <span class=\"tag\">EDITOR'S PICK</span>\n        <div class=\"head\">\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35<small>/月</small></div>\n          <div class=\"annual\">按年付仅需 ¥350/年</div>\n        </div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n          <li>可参与内测节点体验</li>\n        </ul>\n        <p class=\"note\">编辑推荐的一档。覆盖家庭多设备、流媒体重度观看与跨区游戏，是大多数订阅者最终停留的位置。</p>\n      </article>\n\n      <article class=\"plan\">\n        <span class=\"tag muted\">FOR TEAMS</span>\n        <div class=\"head\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85<small>/月</small></div>\n          <div class=\"annual\">按年付仅需 ¥850/年</div>\n        </div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n          <li>可开具增值税专用发票</li>\n        </ul>\n        <p class=\"note\">面向工作室与小团队。除更高的配额外，提供可被同事看见的用量面板，方便统一报销与协作。</p>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n<section class=\"block alt\" id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">Clients · 客户端</div>\n    <h2>四块系统，<em>同一只</em>熊。</h2>\n    <p class=\"lede\">Bear 的客户端在不同系统下保持一致的配色和操作路径。下面列出当前已知的下载入口，请在下载前核对系统版本与架构。</p>\n\n    <div class=\"client-row\">\n      <div>\n        <div class=\"os\">Windows · 10 / 11</div>\n        <h4>Bear for Windows</h4>\n        <p>提供 64 位安装包，安装后可在系统托盘静默驻留。</p>\n      </div>\n      <div>\n        <div class=\"os\">macOS · 11+</div>\n        <h4>Bear for macOS</h4>\n        <p>适配 Apple Silicon 与 Intel，原生支持菜单栏模式。</p>\n      </div>\n      <div>\n        <div class=\"os\">iOS · 15+</div>\n        <h4>Bear for iOS</h4>\n        <p>提供 App Store 与 TestFlight 两条安装路径，按需选择。</p>\n      </div>\n      <div>\n        <div class=\"os\">Android · 9+</div>\n        <h4>Bear for Android</h4>\n        <p>支持通用 APK 与 Play 商店两个版本。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"block\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow\">FAQ · 常见问题</div>\n    <h2>被问到的，都<em>写下来</em>。</h2>\n    <p class=\"lede\">下面这组问题来自过去一段时间的真实工单。我们把它们整理成可折叠的列表，鼠标点击即可展开。</p>\n\n    <div class=\"faq-list\">\n\n      <details>\n        <summary>订阅 Bear 之前，我需要准备什么？</summary>\n        <p>建议先确认自己的设备系统版本与流量使用习惯。Bear 的客户端目前覆盖 Windows、macOS、iOS 与 Android 四大平台，订阅后我们会通过站内消息发送订阅链接与使用说明。</p>\n        <p>如果你计划用于团队协作，请优先阅读团队版的「企业定制路由」说明。</p>\n      </details>\n\n      <details>\n        <summary>套餐里的「极速流量」是什么意思？会不会有二次限速？</summary>\n        <p>「极速流量」指在套餐标定额度内不会被系统额外降速。当月用量超过额度后，连接仍可建立，但优先级会被调整到共享带宽池；下个月 1 月 1 日额度自动恢复。</p>\n        <p>我们不在套餐说明之外做隐性限速，也不会在月末突击调整策略。</p>\n      </details>\n\n      <details>\n        <summary>不同套餐之间的设备数怎么计算？</summary>\n        <p>设备数以同时在线的客户端实例计算，而非累计登录次数。例如旗舰版允许 5 台设备同时连接，第 6 台上线时，最早登录的那一台会被静默下线。</p>\n        <p>这样设计是为了避免账号被无限制共享。</p>\n      </details>\n\n      <details>\n        <summary>按月付和按年付之间可以切换吗？</summary>\n        <p>可以。在订阅到期前的 7 天内，你可以在用户后台将下个计费周期切换为年付或月付，已支付的部分会按比例折算到下一次扣款中。</p>\n        <p>切换不会立即生效，而是作用于「下一次续费」，避免误操作带来的扣费混乱。</p>\n      </details>\n\n      <details>\n        <summary>工单一般多久会回复？</summary>\n        <p>基础版与团队版工单在工作日 12 小时内回复；旗舰版的「7×24 优先工单」承诺全天 24 小时内回复，包括周末与节假日。</p>\n        <p>如果遇到大规模节点异常，我们会在状态页与社交账号同步发布进展。</p>\n      </details>\n\n      <details>\n        <summary>我可以把订阅借给家人或朋友使用吗？</summary>\n        <p>在同一物理地址内的小规模共享是被允许的，例如家庭成员的设备。但请避免将账号以低价二次转售或在公开群组内分发，这会触发风控并导致账号暂停。</p>\n        <p>如果你有更复杂的需求，团队版会更合适。</p>\n      </details>\n\n      <details>\n        <summary>如果我不想继续订阅，如何取消？</summary>\n        <p>进入用户后台 → 订阅管理 → 关闭自动续费。关闭后，本期订阅仍可使用至到期日，到期后不会再产生任何扣款。</p>\n        <p>我们不设置「必须联系客服才能取消」的流程，整个过程可以在两分钟内完成。</p>\n      </details>\n\n      <details>\n        <summary>套餐里的发票如何申请？</summary>\n        <p>个人版默认提供电子普通发票，可在订单页自助申请；团队版支持开具增值税专用发票，需在订阅时填写完整的公司抬头与税务登记信息。</p>\n        <p>发票一般在申请后的 3 个工作日内开具并发送至预留邮箱。</p>\n      </details>\n\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>Bear · 浅灰夜空下的一只熊。</div>\n    <div>© Bear Network Companion · Field Notes Archive</div>\n  </div>\n</footer>\n\n<nav class=\"bottomnav\" aria-label=\"底部导航\">\n  <div class=\"wrap\">\n    <span class=\"brand\"><span class=\"dot\"></span>Bear</span>\n    <a href=\"#field-notes\">手记</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">FAQ</a>\n    <a href=\"#top\">回到顶部</a>\n  </div>\n</nav>",
