          "version": 3,
          "body": "<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml,body{margin:0;padding:0;background:#f3f1f6;color:#1f1d27;font-family:\"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",\"Noto Sans CJK SC\",sans-serif;line-height:1.75;-webkit-font-smoothing:antialiased}\na{color:#5b2bd9;text-decoration:none;border-bottom:1px solid rgba(91,43,217,.25)}\na:hover{border-bottom-color:#5b2bd9}\nimg,svg{display:block;max-width:100%}\n\n/* palette: 浅灰 #f3f1f6 + 电光紫 #5b2bd9 / #a98bff */\n:root{--bg:#f3f1f6;--bg-alt:#ece9f2;--ink:#1f1d27;--ink-soft:#4a4756;--ink-mute:#6c6878;--rule:#d9d4e3;--purple:#5b2bd9;--purple-soft:#a98bff;--purple-tint:#ece4ff;--paper:#ffffff}\n\n.wrap{max-width:1180px;margin:0 auto;padding:0 28px}\n\n/* —— HERO 海报式 —— */\n.hero{position:relative;min-height:100vh;padding:56px 0 120px;background:var(--bg);overflow:hidden;border-bottom:1px solid var(--rule)}\n.hero::before{content:\"\";position:absolute;inset:auto -10% -30% -10%;height:60%;background:radial-gradient(ellipse at 50% 0,rgba(169,139,255,.35),transparent 60%);pointer-events:none}\n.hero-top{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--ink-mute);letter-spacing:.18em;text-transform:uppercase;border-bottom:1px solid var(--rule);padding-bottom:18px}\n.hero-top .mark{display:flex;align-items:center;gap:10px;font-weight:600;color:var(--ink)}\n.hero-top .mark .dot{width:10px;height:10px;border-radius:50%;background:var(--purple);box-shadow:0 0 0 4px rgba(91,43,217,.18)}\n.hero-top .meta{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:none}\n\n.brand-poster{margin-top:8vh;font-weight:900;line-height:.82;letter-spacing:-.04em;font-size:clamp(120px,26vw,360px);color:var(--ink);text-transform:uppercase;word-break:break-all}\n.brand-poster span{display:block;color:var(--purple)}\n.brand-poster .small{display:block;font-size:clamp(16px,1.6vw,22px);font-weight:500;color:var(--ink-soft);letter-spacing:.